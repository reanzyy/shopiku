<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shopiku" >
        <activity
            android:name=".ui.view.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.view.HomeActivity" android:exported="false" />
        <activity android:name=".ui.view.CartActivity" android:exported="false" />
        <activity android:name=".ui.view.CategoriesActivity" android:exported="false" />
        <activity android:name=".ui.view.CheckoutActivity" android:exported="false" />
        <activity android:name=".ui.view.LoginActivity" android:exported="false" />
        <activity
            android:name=".ui.view.PaymentActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".ui.view.PaymentSuccessActivity" android:exported="false" />
        <activity android:name=".ui.view.PaymentPendingActivity" android:exported="false" />
        <activity android:name=".ui.view.PaymentExpiredActivity" android:exported="false" />
        <activity android:name=".ui.view.ProductDetailActivity" android:exported="false" />
        <activity android:name=".ui.view.ProductsActivity" android:exported="false" />
        <activity android:name=".ui.view.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.view.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.view.ReviewsActivity" android:exported="false" />
        <activity android:name=".ui.view.TrackingActivity" android:exported="false" />

    </application>

</manifest>