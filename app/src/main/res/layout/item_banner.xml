<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@drawable/bg_promo_banner"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/tvPromoBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_promo_badge" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:text="@string/promo_badge_label" android:textColor="@color/colorOnPrimary" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvPromoTitle" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:text="@string/promo_title" android:textColor="@color/colorOnPrimary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvPromoSubtitle" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="@string/promo_subtitle" android:textColor="#E6FFFFFF" android:textSize="12sp" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/btnClaimVoucher" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_promo_cta_btn" android:gravity="center" android:paddingHorizontal="14dp" android:text="@string/btn_claim_voucher" android:textColor="@color/colorPrimary" android:textSize="12sp" android:textStyle="bold" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/bannerIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <View android:layout_width="20dp" android:layout_height="8dp" android:background="@drawable/bg_banner_indicator_active" />
                <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="6dp" android:background="@drawable/bg_banner_indicator_inactive" />
                <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="6dp" android:background="@drawable/bg_banner_indicator_inactive" />
                <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="6dp" android:background="@drawable/bg_banner_indicator_inactive" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

