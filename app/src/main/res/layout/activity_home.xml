<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/colorBackground" tools:context=".ui.view.HomeActivity">
    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appBarHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/colorSurface" app:elevation="@dimen/elevation_low">
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/padding_screen">
            <ImageView android:id="@+id/ivHomeLogo" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@string/content_desc_logo" android:src="@mipmap/ic_launcher" />
            <TextView android:id="@+id/tvHomeBrand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name_shopiku" android:textColor="@color/colorPrimary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvHomePageLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/nav_label_beranda" android:textColor="@color/onSurfaceVariant" android:textSize="12sp" android:textStyle="bold" />
            <ImageView android:id="@+id/ivNotification" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/notification" android:padding="10dp" android:src="@android:drawable/ic_popup_reminder" app:tint="@color/onSurfaceVariant" />
            <ImageView android:id="@+id/ivProfileAvatarSmall" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@string/content_desc_profile_avatar" android:src="@mipmap/ic_person" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefreshHome" android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="72dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!-- Greeting & Address Header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/textPrimary" android:textSize="16sp" android:textStyle="bold" tools:text="Halo, Adriansyah" />
                            <LinearLayout android:id="@+id/btnChangeLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@string/location_icon_desc" android:src="@android:drawable/ic_dialog_map" app:tint="@color/colorPrimary" />
                                <TextView android:id="@+id/tvLocationHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Kirim ke Cirebon • Jawa Barat" android:textColor="@color/onSurfaceVariant" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView android:id="@+id/ivChat" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_circle_btn" android:contentDescription="@string/btn_chat" android:padding="10dp" android:src="@android:drawable/ic_dialog_email" app:tint="@color/textPrimary" />
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp">
                            <ImageView android:id="@+id/ivNotificationSecondary" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_btn" android:contentDescription="@string/notification" android:padding="10dp" android:src="@android:drawable/ic_popup_reminder" app:tint="@color/textPrimary" />
                            <TextView android:id="@+id/tvNotifBadge" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_error_badge" android:gravity="center" android:text="2" android:textColor="@color/colorOnPrimary" android:textSize="10sp" android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                    <!-- Material Design 3 Search Bar -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSearchHome"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:hintEnabled="false"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:startIconTint="@color/onSurfaceVariant"
                        app:endIconMode="clear_text"
                        app:endIconTint="@color/onSurfaceVariant"
                        app:boxCornerRadiusTopStart="24dp"
                        app:boxCornerRadiusTopEnd="24dp"
                        app:boxCornerRadiusBottomStart="24dp"
                        app:boxCornerRadiusBottomEnd="24dp"
                        app:boxStrokeColor="@color/colorPrimary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSearchHome"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_search_home_v2"
                            android:hint="@string/search_hint_home"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:paddingVertical="0dp"
                            android:singleLine="true"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/onSurfaceVariant"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <!-- Promo Banner -->
                <include
                    android:id="@+id/layoutPromoBanner"
                    layout="@layout/item_banner"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginHorizontal="16dp" />

                <!-- Wallet Strip -->
                <LinearLayout android:id="@+id/layoutWalletStrip" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:background="@drawable/bg_wallet_strip" android:elevation="2dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_wallet_icon" android:contentDescription="@string/wallet_label" android:padding="8dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/colorPrimary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wallet_label" android:textColor="@color/onSurfaceVariant" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvWalletAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wallet_amount" android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="28dp" android:layout_marginHorizontal="8dp" android:background="@color/surfaceContainerHighest" />
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_coin_icon" android:contentDescription="@string/coin_label" android:padding="8dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/colorSecondary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coin_label" android:textColor="@color/onSurfaceVariant" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvCoinAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coin_amount" android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/btnTopUp" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/bg_filter_pill_inactive" android:gravity="center" android:paddingHorizontal="12dp" android:text="@string/btn_topup" android:textColor="@color/colorPrimary" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <!-- Category Grid -->
                <GridLayout android:id="@+id/gridCategoriesStatic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:columnCount="4" android:rowCount="2">
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="@string/category_electronics" android:src="@android:drawable/ic_menu_manage" />
                        <TextView style="@style/HomeCategoryLabel" android:text="@string/category_electronics" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="Fashion" android:src="@android:drawable/ic_menu_gallery" />
                        <TextView style="@style/HomeCategoryLabel" android:text="Fashion" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="@string/category_beauty" android:src="@android:drawable/ic_menu_edit" />
                        <TextView style="@style/HomeCategoryLabel" android:text="@string/category_beauty" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="Rumah" android:src="@android:drawable/ic_menu_upload" />
                        <TextView style="@style/HomeCategoryLabel" android:text="Rumah" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="Kuliner" android:src="@android:drawable/ic_menu_crop" />
                        <TextView style="@style/HomeCategoryLabel" android:text="Kuliner" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="@string/category_sports" android:src="@android:drawable/ic_menu_compass" />
                        <TextView style="@style/HomeCategoryLabel" android:text="@string/category_sports" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="@string/category_gaming" android:src="@android:drawable/ic_media_play" />
                        <TextView style="@style/HomeCategoryLabel" android:text="@string/category_gaming" />
                    </LinearLayout>
                    <LinearLayout style="@style/HomeCategoryItem">
                        <ImageView style="@style/HomeCategoryIcon" android:contentDescription="@string/category_automotive" android:src="@android:drawable/ic_menu_directions" />
                        <TextView style="@style/HomeCategoryLabel" android:text="@string/category_automotive" />
                    </LinearLayout>
                </GridLayout>
                <!-- Flash Sale Section -->
                <LinearLayout android:id="@+id/sectionFlashSale" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_flash_sale_header" android:orientation="vertical" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_flash_sale_icon" android:contentDescription="@string/section_flash_sale_title" android:padding="6dp" android:src="@android:drawable/ic_menu_upload" app:tint="@color/colorOnPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/section_flash_sale_title" android:textColor="@color/textPrimary" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvFlashSaleTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_countdown_digit" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:text="02:14:35" android:textColor="@color/colorOnPrimary" android:textSize="10sp" android:textStyle="bold" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView android:id="@+id/tvSeeAllFlashSale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/see_all" android:textColor="@color/colorPrimary" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFlashSale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_flash_sale" />
                </LinearLayout>
                <!-- Rekomendasi Katalog 2 Kolom -->
                <LinearLayout android:id="@+id/sectionRecommendations" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="20dp" android:paddingBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_recommendations" android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_best_pick" android:textColor="@color/onSurfaceVariant" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView style="@style/HomeFilterPillActive" android:text="@string/filter_all" />
                            <TextView style="@style/HomeFilterPillInactive" android:text="@string/filter_bestseller" />
                            <TextView style="@style/HomeFilterPillInactive" android:text="@string/filter_discount" />
                            <TextView style="@style/HomeFilterPillInactive" android:text="@string/filter_local" />
                        </LinearLayout>
                    </HorizontalScrollView>
                    <!-- Katalog Grid 2 Kolom -->
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvProducts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" app:spanCount="2" tools:itemCount="4" tools:listitem="@layout/item_product" />
                    <TextView android:id="@+id/btnLoadMoreProducts" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="32dp" android:layout_marginTop="20dp" android:background="@drawable/bg_load_more_btn" android:gravity="center" android:text="@string/btn_load_more" android:textColor="@color/colorPrimary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation Bar Menempel di Bawah -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color_state"
        app:itemTextColor="@color/bottom_nav_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>