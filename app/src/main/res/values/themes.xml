<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================== -->
    <!--   SHOPIKU - Themes              -->
    <!-- =============================== -->

    <!-- Base Application Theme -->
    <style name="Base.Theme.Shopiku" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Surface / Background -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <!-- Error -->
        <item name="colorError">@color/colorError</item>
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Main App Theme -->
    <style name="Theme.Shopiku" parent="Base.Theme.Shopiku" />

    <!-- Splash Screen Theme (no action bar, full screen) -->
    <style name="Theme.Shopiku.Splash" parent="Theme.Shopiku">
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Auth Theme (Login / Register - Light status bar) -->
    <style name="Theme.Shopiku.Auth" parent="Theme.Shopiku">
        <item name="android:statusBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- =============================== -->
    <!--   AppBar / Toolbar Styles       -->
    <!-- =============================== -->

    <!-- Base Widget Style -->
    <style name="Widget" />
    <style name="Widget.Shopiku" parent="" />

    <style name="Widget.Shopiku.AppBar" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/colorPrimary</item>
        <item name="elevation">@dimen/elevation_appbar</item>
    </style>

    <style name="Widget.Shopiku.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/colorOnPrimary</item>
        <item name="navigationIconTint">@color/colorOnPrimary</item>
    </style>

    <style name="Widget.Shopiku.Toolbar.White" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorSurface</item>
        <item name="titleTextColor">@color/textPrimary</item>
        <item name="navigationIconTint">@color/textPrimary</item>
    </style>

    <!-- =============================== -->
    <!--   Text Appearance Styles        -->
    <!-- =============================== -->

    <style name="TextAppearance.Shopiku.AppName" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Shopiku.Tagline" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="TextAppearance.Shopiku.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Shopiku.ProductName" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">normal</item>
        <item name="fontWeight">500</item>
    </style>

    <style name="TextAppearance.Shopiku.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">@color/textPrice</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Shopiku.PriceStrike" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/textPriceStrike</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Shopiku.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="TextAppearance.Shopiku.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_tiny</item>
        <item name="android:textColor">@color/badgeText</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Shopiku.FlashSalePrice" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/textPrice</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- =============================== -->
    <!--   Button Styles                 -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Shopiku.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Shopiku.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="Widget.Shopiku.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/colorError</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <!-- =============================== -->
    <!--   Card Styles                   -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/cardBackground</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Shopiku.Card.Flat" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardBackgroundColor">@color/cardBackground</item>
        <item name="strokeColor">@color/borderColor</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- =============================== -->
    <!--   Input Styles                  -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
    </style>

    <!-- =============================== -->
    <!--   Chip Styles                   -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/colorBackground</item>
        <item name="chipStrokeColor">@color/borderColor</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Widget.Shopiku.Chip.Variant" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/colorBackground</item>
        <item name="chipStrokeColor">@color/borderColor</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- =============================== -->
    <!--   Bottom Navigation             -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_color_state</item>
        <item name="itemTextColor">@color/bottom_nav_color_state</item>
        <item name="elevation">@dimen/elevation_bottom_nav</item>
    </style>

    <!-- =============================== -->
    <!--   Search Bar                    -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.SearchView" parent="Widget.Material3.SearchBar">
        <item name="android:background">@drawable/bg_search_home_v2</item>
        <item name="android:textColorHint">@color/textHint</item>
    </style>

    <!-- =============================== -->
    <!--   Divider                       -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.Divider">
        <item name="android:background">@color/divider</item>
    </style>

    <!-- =============================== -->
    <!--   Rating Bar                    -->
    <!-- =============================== -->

    <style name="Widget.Shopiku.RatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="colorControlActivated">@color/ratingStarFilled</item>
    </style>


    <!-- Circle image overlay untuk ShapeableImageView -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Home SHOPIKU Category and Filter Styles -->
    <style name="HomeCategoryItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="HomeCategoryIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_category_icon_v2</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/colorPrimary</item>
    </style>

    <style name="HomeCategoryLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeFilterPillActive">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_filter_pill_active</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeFilterPillInactive">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_filter_pill_inactive</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/onSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
